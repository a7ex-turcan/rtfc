<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one executable (spec §3.1): `rtfc daemon`, `rtfc mcp`, `rtfc statusline`, and the
    management CLI are all modes of this binary.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rtfc</RootNamespace>
    <AssemblyName>rtfc</AssemblyName>

    <Version>0.5.2</Version>
    <Product>rtfc</Product>
    <Description>Relay Tool For Contacts: Claude Code to Claude Code messaging between people.</Description>

    <!-- Phase 1 distribution: `dotnet tool install -g rtfc` (spec §16). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rtfc</ToolCommandName>
    <PackageId>rtfc</PackageId>
  </PropertyGroup>

  <!--
    The daemon's local IPC is a Kestrel minimal API on a Unix socket (spec §3.1). The
    request delegate generator replaces reflection-based route binding, which Native AOT
    cannot do.
  -->
  <PropertyGroup>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spec §13, applied by Database on open. -->
    <EmbeddedResource Include="Storage/schema.sql" LogicalName="rtfc.schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rtfc.Tests" />
  </ItemGroup>

</Project>
